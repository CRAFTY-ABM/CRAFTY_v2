FUNCTION_BLOCK BIODIVERSITY

VAR_INPUT
    biodiversity_supply_gap : REAL;
END_VAR

VAR_OUTPUT
    intervention : REAL;
END_VAR

FUZZIFY biodiversity_supply_gap
    TERM negative := (-1, 1) (0, 0);
    TERM zero := (-0.25, 0) (0, 1) (0.25, 0);
    TERM positive := (0, 0) (1, 1);
END_FUZZIFY

DEFUZZIFY intervention
    TERM decrease := (-1, 1) (0, 0);
    TERM maintain := (-0.25, 0) (0, 1) (0.25, 0);
    TERM increase := (0, 0) (1, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK rules
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;
    RULE 1 : IF biodiversity_supply_gap IS negative THEN intervention IS decrease;
    RULE 2 : IF biodiversity_supply_gap IS zero THEN intervention IS maintain;
    RULE 3 : IF biodiversity_supply_gap IS positive THEN intervention IS increase;
END_RULEBLOCK

END_FUNCTION_BLOCK
