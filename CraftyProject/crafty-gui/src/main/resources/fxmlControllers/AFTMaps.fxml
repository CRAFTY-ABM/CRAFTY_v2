<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>


<ScrollPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="de.cesr.crafty.gui.controller.fxml.AFTsMapsController"
	fitToWidth="true" pannable="true" styleClass="responsive-scroll">
	<content>
	<VBox fx:id="TopBox">
	<children>
		<TitledPane animated="true" text="AFT distribution">
			<content>
				<VBox>
					<Button fx:id="aftColors" mnemonicParsing="false"
						onAction="#aftColorsAction" text="Display AFT distribution">
					</Button>
					<PieChart fx:id="pieAFTsDistrebution" />
				</VBox>
			</content>
		</TitledPane>

		<TitledPane animated="true" text="AFT categories">
			<content>
				<VBox>
					<Button fx:id="CategoriesColor" mnemonicParsing="false"
						onAction="#CategoriesColorsAction"
						text="Display AFTs by category">
					</Button>
					<PieChart fx:id="pieAFTsCategories" />
				</VBox>
			</content>
		</TitledPane>
		<TitledPane animated="true" text="AFT intensities">
			<content>
				<!-- <ScrollPane></ScrollPane> -->
				<GridPane fx:id="grid" />

			</content>
		</TitledPane>
	</children>
	</VBox>
	</content>
</ScrollPane>
