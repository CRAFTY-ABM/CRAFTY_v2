<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="de.cesr.crafty.gui.controller.fxml.TargetsPlotController"
	fx:id="TopBox">
	<children>
		<HBox spacing="15.0">
			<children>
				<Button mnemonicParsing="false" onAction="#refreshTargetCharts"
					text="Refresh" />
				<Label text="Targets" />
				<Label fx:id="tickTxt" text="year" />
			</children>
		</HBox>
		<ScrollPane fx:id="scroll" fitToWidth="true"
			hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
			VBox.vgrow="ALWAYS" styleClass="responsive-scroll">
			<GridPane fx:id="gridPaneLinnChart" />
		</ScrollPane>
	</children>
</VBox>
