<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<MenuBar xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="de.cesr.crafty.gui.controller.fxml.MenuBarController">
	<Menu text="File">
		<items>
			<MenuItem text="Open project from file system..."
				accelerator="Ctrl+Alt+O" onAction="#open">
			<!-- 	 <graphic>
					<FontIcon iconLiteral="far-folder" iconSize="15" />
				</graphic> --> 
			</MenuItem>
			<Menu text="Recent Projects" fx:id="recent">
				<!--  <graphic>
					<FontIcon iconLiteral="far-folder-open" iconSize="15" />
				</graphic>  -->
			</Menu>
			<SeparatorMenuItem />
			<MenuItem text="Restart" onAction="#restart" />
			<MenuItem text="Exit" onAction="#Exit" />
		</items>
	</Menu>
	<Menu text="Edit">
		<MenuItem fx:id="dataAnalysis"
			text="Generate input data analysis directory"
			onAction="#dataAnalysisDirectory">
			<!--  <graphic>
				<FontIcon iconLiteral="far-save" iconSize="15" />
			</graphic> -->
		</MenuItem>
	</Menu>
	<Menu text="View">
		<MenuItem text="Increase text size" accelerator="Ctrl+PLUS"
			onAction="#increaseTextSize" />
		<MenuItem text="Decrease text size" accelerator="Ctrl+MINUS"
			onAction="#decreaseTextSize" />
		<MenuItem text="Reset text size" accelerator="Ctrl+0"
			onAction="#resetTextSize" />
	</Menu>
	<Menu text="Help">
		<MenuItem text="CRAFTY website" onAction="#welcome" />
	</Menu>
</MenuBar>
