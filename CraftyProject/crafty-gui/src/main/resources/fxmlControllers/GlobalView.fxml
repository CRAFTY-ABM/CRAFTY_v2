<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="de.cesr.crafty.gui.controller.fxml.GlobalViewFXMLController"
	fx:id="TopBox" spacing="10.0" styleClass="institution-dashboard">
	<children>
		<HBox alignment="CENTER_LEFT" spacing="12.0"
			styleClass="institution-dashboard-toolbar">
			<children>
				<Button mnemonicParsing="false" onAction="#refreshTables"
					text="Refresh" />
				<Label text="Global configuration"
					styleClass="institution-dashboard-title" />
			</children>
		</HBox>
		<ScrollPane fx:id="scroll" fitToWidth="true"
			hbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
			styleClass="institution-dashboard-scroll">
			<content>
				<VBox fx:id="contentBox" spacing="16.0" />
			</content>
		</ScrollPane>
	</children>
</VBox>
