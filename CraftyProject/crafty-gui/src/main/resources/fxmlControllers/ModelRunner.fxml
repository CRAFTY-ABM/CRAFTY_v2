<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="de.cesr.crafty.gui.controller.fxml.ModelRunnerController"
	fx:id="TopBox">
	<children>
		<HBox spacing="15.0">
			<children>
				<Button fx:id="oneStep" mnemonicParsing="false"
					onAction="#oneStep" text="One step"><!-- styleClass="button-icon"> -->
					<!-- <graphic> <FontIcon iconLiteral="fas-step-forward" iconSize="20" 
						/> </graphic> -->
				</Button>
				<Button fx:id="run" mnemonicParsing="false" onAction="#run"
					text="Run"><!-- styleClass="button-icon"> -->
					<!-- <graphic> <FontIcon iconLiteral="far-play-circle" iconSize="22" 
						/> </graphic> -->
				</Button>
				<Button fx:id="stop" mnemonicParsing="false" onAction="#stop"
					text="Stop &amp; Reset"><!-- styleClass="button-icon"> -->
					<!-- <graphic> <FontIcon iconLiteral="far-stop-circle" iconSize="22" 
						/> </graphic> -->
				</Button>
				<Button onAction="#selecserivce"
					text="Display a service"><!-- styleClass="button-icon"> -->
					<!-- <graphic> <FontIcon iconLiteral="fas-list-ul" iconSize="20" /> 
						</graphic> -->
				</Button>
				<Label fx:id="tickTxt" text="year" />
			</children>
		</HBox>
		<ScrollPane fx:id="scroll">
			<GridPane fx:id="gridPaneLinnChart" />
		</ScrollPane>

	</children>
</VBox>
